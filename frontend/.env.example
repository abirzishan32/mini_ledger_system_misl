# Base URL of the ASP.NET backend.
#
# Server-side only, deliberately NOT prefixed with NEXT_PUBLIC_. The browser
# never calls the backend directly: it talks to this Next.js app, which forwards
# the request and keeps the access and refresh tokens in HttpOnly cookies. A
# NEXT_PUBLIC_ variable would be inlined into the client bundle.
#
# Copy this file to .env and adjust. Put machine-specific or secret overrides in
# .env.local, which is never committed.
API_BASE_URL=http://localhost:5031
