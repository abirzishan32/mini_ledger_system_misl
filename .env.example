# Copy to .env before running docker compose. .env is gitignored.
#
#   cp .env.example .env
#   # then replace JWT_SIGNING_KEY and POSTGRES_PASSWORD with your own values

# Database. The backend's connection string is assembled from these in
# docker-compose.yml, so the two cannot drift apart.
POSTGRES_DB=mini_ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me

# Signs every access token. Must be long and random: anyone holding it can mint
# a token for any user. Tokens are signed with HMAC-SHA512, so this value must
# be at least 64 characters or the API rejects every sign-in. Generate one with
#   openssl rand -base64 48
# which produces exactly 64 characters.
JWT_SIGNING_KEY=CHANGE-ME-run-openssl-rand-base64-48-and-paste-the-result-here!!

# Development keeps Swagger UI available at /swagger. Use Production to turn it
# off; error responses are identical either way.
ASPNETCORE_ENVIRONMENT=Development

# Host ports. Change these if something is already listening.
FRONTEND_PORT=3000
BACKEND_PORT=5031
